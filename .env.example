# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# First Admin user to promote automatically
ADMIN_EMAIL=admin@msot.edu

# Demo Mode switch: shows quick role switcher & mock credentials
NEXT_PUBLIC_DEMO_MODE=true

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security / Verification HMAC Secret (Phase 4 Certificates)
HMAC_SECRET=super-secret-trackstack-hmac-key-2026

# Cron Secret for automated scheduled endpoints (Phase 5)
CRON_SECRET=mirai-trackstack-cron-secret-2026

# Email Provider (Resend - console fallback if empty)
RESEND_API_KEY=

# Lumi AI Assistant (Google Gemini SDK - keyword fallback if empty)
GEMINI_API_KEY=
LUMI_MODEL=gemini-2.5-flash
